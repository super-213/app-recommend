---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const apps = (await getCollection('apps')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const summaries = apps.map(a=>({id:a.id.replace(/\/index$/, ''),...a.data,icon:a.data.icon?.src}));
const platforms = ['macOS', 'Windows', 'Linux'];
const tags = [...new Set(apps.flatMap(a=>a.data.tags))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
const categories = tags.filter(t => !platforms.includes(t));
---
<Base><main class="catalog"><div class="search-wrap"><div class="search-box"><span aria-hidden="true" class="search-icon">⌕</span><input id="search" type="search" placeholder="搜索软件名称" aria-label="搜索软件名称" autocomplete="off"/><kbd>⌘ K</kbd></div></div><section class="content"><div class="filter-row"><span class="section-label">TAGS <span class="label-line"></span></span><div id="tags" class="filter-groups"><div class="tags" aria-label="分类筛选"><button class="tag active" data-tag="" aria-pressed="true">全部</button>{categories.map(t=><button class="tag" data-tag={t} aria-pressed="false">{t.toLowerCase() === "agent" ? "Agent" : t}</button>)}</div><div class="tags platform-tags" aria-label="平台筛选">{platforms.filter(t=>tags.includes(t)).map(t=><button class="tag" data-tag={t} aria-pressed="false">{t}</button>)}</div></div></div><div class="list-heading"><span id="count" class="count" data-total={apps.length}>{apps.length.toString().padStart(2,'0')} ITEMS</span><div class="view-switch" role="group" aria-label="显示方式"><button type="button" class="view-button active" data-view="grid" aria-pressed="true">网格</button><button type="button" class="view-button" data-view="list" aria-pressed="false">列表</button></div></div><div id="notice" class="notice" hidden></div><div id="cards" class="cards">{summaries.slice(0,9).map(a=><a class="card" href={`/apps/${a.id}/`}><div class="card-top"><div class="app-icon">{a.icon ? <img src={a.icon} alt="" loading="lazy" width="52" height="52"/> : <span>{a.title.charAt(0).toUpperCase()}</span>}</div><span class="card-arrow">↗</span></div><div><h2>{a.title}</h2><p>{a.description}</p></div><div class="card-footer"><span class:list={["origin", { mine: a.origin === "self" }]}>{a.origin === 'self' ? '自己制作' : '推荐'}</span>{a.tags.map(t=><span class:list={["chip", { platform: platforms.includes(t) }]}>{t.toLowerCase() === "agent" ? "Agent" : t}</span>)}</div></a>)}</div><nav id="pagination" class="pagination" aria-label="分页"></nav></section></main><script src="../scripts/catalog.ts"></script></Base>
